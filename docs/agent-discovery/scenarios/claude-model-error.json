{
 "claude_status": true,
 "status_interval": 0.4,
 "steps": [
  {
   "wait_text": "for agents",
   "timeout": 40
  },
  {
   "key": "ctrl-c"
  },
  {
   "sleep": 2
  },
  {
   "type": "Reply with exactly the word OK."
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "mark": "submitted-bad-model"
  },
  {
   "sleep": 10
  },
  {
   "mark": "after-failure"
  },
  {
   "type": "/exit"
  },
  {
   "sleep": 1
  },
  {
   "key": "enter"
  }
 ],
 "exit_timeout": 15
}
