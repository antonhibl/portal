{
 "claude_status": false,
 "status_interval": 0.4,
 "steps": [
  {
   "wait_text": "Trust project folder",
   "timeout": 40
  },
  {
   "sleep": 1
  },
  {
   "key": "down"
  },
  {
   "sleep": 0.3
  },
  {
   "key": "down"
  },
  {
   "sleep": 0.3
  },
  {
   "key": "enter"
  },
  {
   "sleep": 3
  },
  {
   "type": "Use the bash tool to run exactly: sleep 3; then reply DONE."
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "mark": "submitted"
  },
  {
   "sleep": 12
  },
  {
   "mark": "after-turn"
  },
  {
   "type": "Use the bash tool to run exactly: sleep 20"
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "mark": "submitted-2"
  },
  {
   "sleep": 5
  },
  {
   "mark": "cancel"
  },
  {
   "key": "esc"
  },
  {
   "sleep": 4
  },
  {
   "mark": "after-cancel"
  },
  {
   "key": "ctrl-d"
  }
 ],
 "exit_timeout": 15,
 "env": {
  "SPIKE_PI_LOG": "$TMPDIR/probe/runs/pi4.lifecycle.jsonl"
 }
}
