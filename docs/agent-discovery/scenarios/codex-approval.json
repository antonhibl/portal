{
 "claude_status": false,
 "status_interval": 0.4,
 "steps": [
  {
   "wait_text": "gpt-.*· ~/workspace/portal",
   "timeout": 40
  },
  {
   "sleep": 3
  },
  {
   "mark": "first-prompt"
  },
  {
   "type": "Run exactly this shell command and nothing else: touch ~/.cache/portal-spike-codex-approved"
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "wait_text": "Would you like to run|Yes, proceed|Yes, just this once",
   "timeout": 90
  },
  {
   "mark": "approval-1"
  },
  {
   "sleep": 4
  },
  {
   "key": "enter"
  },
  {
   "mark": "approved"
  },
  {
   "sleep": 15
  },
  {
   "mark": "after-turn-2"
  },
  {
   "type": "Run exactly this shell command and nothing else: touch ~/.cache/portal-spike-codex-denied"
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "wait_text": "Would you like to run|Yes, proceed|Yes, just this once",
   "timeout": 90
  },
  {
   "mark": "approval-2"
  },
  {
   "sleep": 3
  },
  {
   "key": "esc"
  },
  {
   "mark": "denied"
  },
  {
   "sleep": 10
  },
  {
   "mark": "after-deny"
  },
  {
   "type": "Write the numbers from 1 to 300, one per line, with no other text."
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "sleep": 5
  },
  {
   "mark": "cancel"
  },
  {
   "key": "esc"
  },
  {
   "sleep": 8
  },
  {
   "mark": "after-cancel"
  },
  {
   "type": "/quit"
  },
  {
   "sleep": 1
  },
  {
   "key": "enter"
  },
  {
   "mark": "exit-typed"
  }
 ],
 "exit_timeout": 15
}
