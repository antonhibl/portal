{
 "claude_status": false,
 "status_interval": 0.4,
 "steps": [
  {
   "wait_text": "Trust project folder",
   "timeout": 40
  },
  {
   "mark": "trust-dialog",
   "tree": true
  },
  {
   "sleep": 3
  },
  {
   "key": "down"
  },
  {
   "sleep": 0.3
  },
  {
   "key": "down"
  },
  {
   "sleep": 0.3
  },
  {
   "key": "enter"
  },
  {
   "sleep": 4
  },
  {
   "mark": "first-prompt"
  },
  {
   "focus": "out"
  },
  {
   "type": "Reply with exactly the word OK and nothing else."
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "mark": "submitted-1"
  },
  {
   "sleep": 15
  },
  {
   "mark": "after-turn-1"
  },
  {
   "type": "Use the bash tool to run: sleep 4; then reply DONE."
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "sleep": 2
  },
  {
   "mark": "queue-followup"
  },
  {
   "type": "Also reply with the word AGAIN."
  },
  {
   "sleep": 0.5
  },
  {
   "key": "alt-enter"
  },
  {
   "sleep": 20
  },
  {
   "mark": "after-turn-2"
  },
  {
   "type": "Write the numbers from 1 to 300, one per line, with no other text."
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "sleep": 5
  },
  {
   "mark": "cancel"
  },
  {
   "key": "esc"
  },
  {
   "sleep": 6
  },
  {
   "mark": "after-cancel"
  },
  {
   "key": "ctrl-d"
  },
  {
   "mark": "exit-typed"
  }
 ],
 "exit_timeout": 15,
 "env": {
  "SPIKE_PI_LOG": "$TMPDIR/probe/runs/pi2.lifecycle.jsonl"
 }
}
