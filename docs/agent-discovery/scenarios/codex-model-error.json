{
 "claude_status": false,
 "status_interval": 0.4,
 "steps": [
  {
   "wait_text": "· ~/workspace/portal",
   "timeout": 40
  },
  {
   "sleep": 2
  },
  {
   "type": "Reply with exactly the word OK."
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "mark": "submitted"
  },
  {
   "sleep": 10
  },
  {
   "mark": "after-failure"
  },
  {
   "type": "/quit"
  },
  {
   "sleep": 1
  },
  {
   "key": "enter"
  }
 ],
 "exit_timeout": 15
}
