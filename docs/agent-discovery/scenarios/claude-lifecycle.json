{
 "claude_status": true,
 "status_interval": 0.4,
 "steps": [
  {
   "wait_text": "\\? for shortcuts",
   "timeout": 40
  },
  {
   "mark": "first-prompt",
   "agents": false
  },
  {
   "sleep": 3
  },
  {
   "type": "Use the Bash tool to run exactly this command: touch $TMPDIR/claude-approved.txt"
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "wait_text": "Do you want to proceed",
   "timeout": 60
  },
  {
   "mark": "permission-dialog-1"
  },
  {
   "sleep": 4
  },
  {
   "key": "enter"
  },
  {
   "mark": "approved"
  },
  {
   "sleep": 8
  },
  {
   "mark": "after-turn-approve"
  },
  {
   "type": "Use the Bash tool to run exactly this command: touch $TMPDIR/claude-denied.txt"
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "wait_text": "Do you want to proceed",
   "timeout": 60
  },
  {
   "mark": "permission-dialog-2"
  },
  {
   "sleep": 3
  },
  {
   "key": "esc"
  },
  {
   "mark": "denied"
  },
  {
   "sleep": 6
  },
  {
   "mark": "after-deny"
  },
  {
   "type": "Write the numbers from 1 to 300, one per line, with no other text."
  },
  {
   "sleep": 0.5
  },
  {
   "key": "enter"
  },
  {
   "sleep": 3
  },
  {
   "mark": "cancel"
  },
  {
   "key": "esc"
  },
  {
   "sleep": 6
  },
  {
   "mark": "after-cancel"
  },
  {
   "type": "/exit"
  },
  {
   "sleep": 1
  },
  {
   "key": "enter"
  },
  {
   "mark": "exit-typed"
  }
 ],
 "exit_timeout": 15
}
