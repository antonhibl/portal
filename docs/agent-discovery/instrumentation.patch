+/// SPIKE (agent-discovery-spike, not for merge): log terminal callbacks.
+enum SpikeTrace {
+    static let handle: FileHandle? = {
+        guard let path = ProcessInfo.processInfo.environment["PORTAL_SPIKE_TRACE"], !path.isEmpty else { return nil }
+        FileManager.default.createFile(atPath: path, contents: nil)
+        return FileHandle(forWritingAtPath: path)
+    }()
+    static func log(_ target: String?, _ event: String, _ fields: [String: Any] = [:]) {
+        guard let handle else { return }
+        var record: [String: Any] = ["mono_ns": clock_gettime_nsec_np(CLOCK_UPTIME_RAW),
+                                     "wall": Date().timeIntervalSince1970,
+                                     "target": target ?? "?", "event": event]
+        for (key, value) in fields { record[key] = value }
+        if var data = try? JSONSerialization.data(withJSONObject: record, options: [.sortedKeys]) {
+            data.append(0x0a)
+            handle.write(data)
+        }
+    }
+}
