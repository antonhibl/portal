#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# task — git-native task tracker. The manual is usage() below; run `task help`.
set -euo pipefail

usage() {
  cat <<'EOF'
task — a git-native task tracker for humans and coding agents.

Tasks are markdown files in a folder (default: tasks/ at the repo root).
Claiming a task creates the git branch task/<id>. Git creates branches
atomically and every worktree sees them at once, so two agents can never
claim the same task.

USAGE
  task [-d <dir>] <command> [args]

COMMANDS
  list [--tsv]             Show every task with its state, and notes on its
                           branch and worktree that may need you.
                             --tsv  one line per task for scripts and
                                    editors, with tab-separated columns:
                                    1 state
                                    2 ID
                                    3 title
                                    4 unmet blockers, separated by spaces
                                    5 branch: new (no commits yet), ahead
                                      (commits not on main), merged, or
                                      empty when there is no task/<id>
                                    6 worktree path, if it has one
                                    7 worktree: clean, dirty or missing
                                    8 note, as list shows it
  ready                    Print the IDs of all ready tasks.
  next                     Print the ID of the first ready task.
  add [-p <parent>] [-b <id>]... [-F <file>] <title>
                           Create a task file and print its ID.
                             -p  put it under <parent>. If <parent> is a task
                                 file, it becomes a folder and its text becomes
                                 the folder's README.md (shared context).
                             -b  blocked by <id>; repeat for several.
                             -F  read the task body from <file>; - is stdin.
  claim [<id>]             Claim <id>, or the next ready task. Creates branch
                           task/<id> and its worktree; prints the worktree path.
  done [<id>]              Set status: done in the task file. Without <id>,
                           uses the task of the current task/<id> branch.
                           A claimed task is done only on its own branch.
  path [<id>]              Print the absolute path of the task file in this
                           worktree, then the README.md of each folder above
                           it, from the top down. Without <id>, uses the
                           task of the current task/<id> branch.
  finish [--force] <id>... Clean up after a task's merge: remove its worktree
                           and delete task/<id>. A task its merge left todo
                           is marked done on main, uncommitted. Refuses when
                           the branch has commits that aren't on main, or
                           none yet, or the worktree has uncommitted changes.
                             --force  drop that work too. An unfinished task
                                      is ready again.
  finish --all             Finish every task whose branch is merged and whose
                           worktree has no uncommitted changes.
  help                     Show this manual.

OPTIONS
  -d <dir>                 Tasks folder. Default: tasks/ in the main worktree.

TASK FILES
  A task's ID is its path inside the tasks folder, without .md:

    tasks/
      auth/
        README.md                  context shared by every task in auth/
        01-login-form.md           ID: auth/01-login-form
        02-logout-button.md        ID: auth/02-logout-button

  A task file:

    ---
    status: todo                   todo | done | wontfix
    blocked-by: [auth/01-login-form]
    ---
    # Add a logout button

    What to do, and how to check it's done.

  A folder's README.md may set:
    blocked-by: [<id>, ...]        applies to every task in the folder
    ordered: true                  each task waits for the one before it

  blocked-by may name a folder. A folder is done when all its tasks are.

STATES
  ready      todo, not claimed, every blocker done
  blocked    todo, waiting on a blocker (list shows which)
  claimed    branch task/<id> exists
  done       status: done
  wontfix    status: wontfix

  State is read from the main worktree, so a task counts as done only
  once its branch is merged. next picks in path order, so the NN- prefixes
  set priority.

  list notes what may need you:
    merged, but not done on main    the branch merged without task done
    done on its branch, not merged  waiting for its merge
    branch remains                  done, but task/<id> is not cleaned up
    no worktree / worktree is gone  claimed, with no usable worktree
    uncommitted changes             in its worktree

  "merged" means the branch has commits since it was claimed, all of them
  on main. A squash or rebase merge leaves the branch "ahead".

WORKFLOW FOR AGENTS
  1. cd "$(task claim)"          claim the next ready task, enter its worktree
  2. Read the files task path prints: the task file, then every README.md
     in the folders above it.
  3. Do the work; commit on the task/<id> branch.
  4. task done && git commit -am "done: <id>"
  5. Get task/<id> merged into main, then outside its worktree:
       task finish <id>

  To drop a task unfinished: task finish --force <id>
  New tasks must be committed on main before they can be claimed.

EXAMPLES
  task add -p auth "Login form"                      new task auth/01-login-form
  task add -p auth -b auth/01-login-form "Logout button"
  task add -p auth/01-login-form "Validate email"    split a task into subtasks
  task add -p auth -F notes.md "Session timeout"     body from a file
  task add -p auth -F - "Rate limit" <<'BODY'        body from stdin (heredoc)
  Limit login attempts to 5 per minute per IP.

  Done when: the 6th attempt within a minute returns 429.
  BODY
  task list                                          see what is blocked and why
  task claim auth/02-logout-button                   claim a specific task
  task path                                          files to read for this branch's task
  task -d .scratch/plan next                         use another tasks folder
  TASK_WORKTREES=~/wt task claim                     put worktrees elsewhere

ENVIRONMENT
  TASK_WORKTREES           Where claim creates worktrees.
                           Default: <repo>.worktrees/, next to the repo.
EOF
}

die() { echo "task: $*" >&2; exit 1; }
# Wrong usage: show the manual, with the error last so it isn't scrolled away.
usage_error() { usage >&2; echo >&2; die "$*"; }

mainwt=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0, 10); exit}')
root=""
if [[ "${1:-}" == "-d" ]]; then
  [[ -n "${2:-}" ]] || usage_error "-d needs a folder, e.g. task -d .scratch/plan list"
  root=$2; shift 2
fi
root=${root:-${mainwt:-.}/tasks}
[[ -d "$root" ]] && root=$(cd "$root" && pwd -P)
root=${root%/}

# One line per task, in path order: state \t id \t title \t unmet blockers
read -r -d '' SCAN <<'AWK' || true
function parent(x) { return x ~ /\// ? substr(x, 1, match(x, /\/[^\/]*$/) - 1) : "" }
function isdone(x,   l, any) {
  if (x in leaf) return status[x] == "done" || status[x] == "wontfix"
  any = 0
  for (l in leaf) if (index(l, x "/") == 1) { if (!isdone(l)) return 0; any = 1 }
  return any
}
function need(x) { if (x != "" && !isdone(x) && index(" " unmet " ", " " x " ") == 0) unmet = unmet " " x }
function needall(s,   d, m, j) { m = split(s, d, " "); for (j = 1; j <= m; j++) need(d[j]) }
FILENAME == "-" { claimed[$0] = 1; next }
FNR == 1 {
  id = substr(FILENAME, length(root) + 2); sub(/\.md$/, "", id)
  if (id == "README" || id ~ /\/README$/) id = parent(id)
  else { leaf[id] = 1; ids[++n] = id; status[id] = "todo" }
  fm = ($0 == "---"); key = ""; titled = 0
  if (fm) next
}
fm && $0 == "---" { fm = 0; next }
fm {
  v = $0
  if (v ~ /^[ \t]*- / && key == "blocked-by") { sub(/^[ \t]*- */, "", v); deps[id] = deps[id] " " v; next }
  key = v; sub(/:.*/, "", key); sub(/^[^:]*:[ \t]*/, "", v); sub(/[ \t]+#.*/, "", v); gsub(/"/, "", v)
  if (key == "status") status[id] = v
  else if (key == "blocked-by") { gsub(/\[|\]|,/, " ", v); deps[id] = deps[id] " " v }
  else if (key == "ordered") ordered[id] = (v == "true")
  next
}
!titled && /^# / { title[id] = substr($0, 3); gsub(/\t/, " ", title[id]); titled = 1 }
END {
  for (i = 1; i <= n; i++)  # link each node to its previous sibling (input is sorted)
    for (x = ids[i]; x != ""; x = p) {
      p = parent(x)
      if (!(x in seen)) { seen[x] = 1; prev[x] = last[p]; last[p] = x }
    }
  for (i = 1; i <= n; i++) {
    x = ids[i]; unmet = ""
    needall(deps[x])
    for (y = x; ; y = p) {
      p = parent(y)
      if (ordered[p]) need(prev[y])
      needall(deps[p])
      if (p == "") break
    }
    state = isdone(x) ? status[x] : (x in claimed) ? "claimed" : unmet != "" ? "blocked" : "ready"
    print state "\t" x "\t" title[x] "\t" substr(unmet, 2)
  }
}
AWK

scan() {
  local files=() f
  if [[ -d "$root" ]]; then
    while IFS= read -r f; do files+=("$f"); done < <(find "$root" -type f -name '*.md' | LC_ALL=C sort)
  fi
  git for-each-ref --format='%(refname:strip=3)' refs/heads/task/ 2>/dev/null |
    awk -v root="$root" "$SCAN" - ${files[@]+"${files[@]}"}
}

# One line per task branch: id \t branch \t status on the branch \t worktree \t worktree state
facts() {
  local head wts id ref created b status wt ws line
  head=$(git -C "$mainwt" rev-parse -q --verify HEAD 2>/dev/null) || return 0
  wts=$(git worktree list --porcelain | awk '
    /^worktree / { p = substr($0, 10); m = 0 }
    /^branch refs\/heads\/task\// { b = substr($0, 24) }
    /^prunable/ { m = 1 }
    /^$/ { if (b != "") print b "\t" p "\t" m; b = "" }
    END { if (b != "") print b "\t" p "\t" m }')
  git for-each-ref --format='%(refname:strip=3)' refs/heads/task/ | while IFS= read -r id; do
    ref=refs/heads/task/$id
    created=$(git log -g --format=%H "$ref" -- 2>/dev/null | tail -1)
    if (($(git rev-list --count "$head..$ref"))); then b=ahead
    elif [[ "$(git rev-parse "$ref")" == "$created" ]]; then b=new
    else b=merged; fi
    status=""
    if [[ "$root" == "$mainwt"/* ]]; then
      status=$(git show "$ref:${root#"$mainwt"/}/$id.md" 2>/dev/null |
        awk 'NR == 1 && $0 != "---" { exit } NR > 1 && $0 == "---" { exit }
             /^status:/ { sub(/^status:[ \t]*/, ""); sub(/[ \t]+#.*/, ""); gsub(/"/, ""); print; exit }')
    fi
    line=$(awk -F'\t' -v id="$id" '$1 == id' <<< "$wts")
    wt="" ws=""
    if [[ -n "$line" ]]; then
      wt=$(cut -f2 <<< "$line")
      if [[ "$(cut -f3 <<< "$line")" == 1 || ! -d "$wt" ]]; then ws=missing
      elif [[ -n "$(git -C "$wt" status --porcelain)" ]]; then ws=dirty
      else ws=clean; fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$b" "$status" "$wt" "$ws"
  done
}

# scan, with each task's branch, worktree, worktree state and note: see list --tsv
report() {
  awk -F'\t' -v OFS='\t' '
    function add(s) { note = note (note != "" ? "; " : "") s }
    FILENAME == ARGV[1] { br[$1] = $2; bs[$1] = $3; wt[$1] = $4; ws[$1] = $5; next }
    { id = $2; note = ""
      if (id in br) {
        if ($1 == "claimed" && br[id] == "merged") add("merged, but not done on main")
        if ($1 == "claimed" && br[id] == "ahead" && bs[id] == "done") add("done on its branch, not merged")
        if ($1 == "done" || $1 == "wontfix") add("branch remains")
        if ($1 == "claimed" && wt[id] == "") add("no worktree")
        if (ws[id] == "missing") add("worktree is gone")
        if (ws[id] == "dirty") add("uncommitted changes")
      }
      print $1, $2, $3, $4, br[id], wt[id], ws[id], note }' <(facts) <(scan)
}

cmd_list() {
  if (($#)); then
    [[ "$1" == --tsv && $# == 1 ]] || usage_error "list takes no arguments but --tsv"
    report
    return
  fi
  report | awk -F'\t' '{ b = $4; gsub(/ /, ", ", b)
                         printf "%-8s %s%s%s%s\n", $1, $2, ($3 != "" ? "  " $3 : ""),
                                ($1 == "blocked" ? "  (blocked by " b ")" : ""),
                                ($8 != "" ? "  [" $8 "]" : "") }'
}

cmd_next() {
  local id
  id=$(scan | awk -F'\t' '$1 == "ready" && !f { print $2; f = 1 }')
  if [[ -z "$id" ]]; then
    [[ -n "$(scan)" ]] || die "no tasks in $root. Add one: task add \"<title>\""
    { echo "task: no ready task. Every todo task is blocked or claimed:"; cmd_list; } >&2
    exit 1
  fi
  echo "$id"
}

cmd_add() {
  local parent="" deps="" title="" body="" dir num=0 n f slug id fm
  while (($#)); do
    case "$1" in
      -p) [[ -n "${2:-}" ]] || usage_error "-p needs a parent id, e.g. task add -p auth \"Login form\""
          parent=$2; shift 2 ;;
      -b) [[ -n "${2:-}" ]] || usage_error "-b needs a task id, e.g. task add -b auth/01-login-form \"Logout button\""
          [[ -f "$root/$2.md" || -d "$root/$2" ]] || die "unknown task: $2. See the IDs in: task list"
          deps+="${deps:+, }$2"; shift 2 ;;
      -F) [[ -n "${2:-}" ]] || usage_error "-F needs a file, or - for stdin, e.g. task add -F notes.md \"Login form\""
          if [[ "$2" == - ]]; then body=$(cat); else
            [[ -f "$2" ]] || die "no such file: $2"; body=$(cat "$2"); fi
          shift 2 ;;
      -*) usage_error "unknown option for add: $1" ;;
      *)  title+="${title:+ }$1"; shift ;;
    esac
  done
  [[ -n "$title" ]] || usage_error "add needs a title, e.g. task add \"Login form\""
  parent=${parent%/}
  dir="$root${parent:+/$parent}"
  if [[ -n "$parent" && -f "$dir.md" ]]; then  # leaf -> folder; its body becomes shared context
    git show-ref -q --verify "refs/heads/task/$parent" &&
      die "$parent is claimed, so it can't be split into subtasks until it's merged or released"
    mkdir -p "$dir" && mv "$dir.md" "$dir/README.md"
  fi
  mkdir -p "$dir"
  for f in "$dir"/[0-9]*; do
    [[ -e "$f" ]] || continue
    n=${f##*/}; n=${n%%[!0-9]*}
    if ((10#$n > num)); then num=$((10#$n)); fi
  done
  slug=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/^-*//; s/-*$//')
  id="${parent:+$parent/}$(printf '%02d' $((num + 1)))-$slug"
  fm="status: todo"
  if [[ -n "$deps" ]]; then fm+=$'\n'"blocked-by: [$deps]"; fi
  { printf -- '---\n%s\n---\n# %s\n' "$fm" "$title"
    if [[ -n "$body" ]]; then printf '\n%s\n' "$body"; fi; } > "$root/$id.md"
  echo "$id"
}

cmd_claim() {
  local id base line dir tries=0
  (($# <= 1)) || usage_error "claim takes at most one task id"
  [[ -n "$mainwt" ]] || die "not in a git repo; tasks are claimed with git branches"
  base=$(git -C "$mainwt" branch --show-current)
  [[ -n "$base" ]] || die "the main worktree ($mainwt) is not on a branch; check out main there"
  if (($#)); then
    id=$1
    line=$(scan | awk -F'\t' -v id="$id" '$2 == id { b = $4; gsub(/ /, ", ", b); print $1 "\t" b }')
    case "${line%%$'\t'*}" in
      ready)   git branch "task/$id" "$base" || die "could not claim $id" ;;
      blocked) die "$id is blocked by ${line#*$'\t'}. Pick a ready one: task next" ;;
      claimed) die "$id is already claimed (branch task/$id exists). Pick another: task next" ;;
      "")      die "unknown task: $id. See the IDs in: task list" ;;
      *)       die "$id is already ${line%%$'\t'*}" ;;
    esac
  else  # another agent may win the race between next and branch; just retry
    while :; do
      id=$(cmd_next) || exit 1
      git branch "task/$id" "$base" 2>/dev/null && break
      tries=$((tries + 1)); [[ $tries -lt 5 ]] || die "could not claim $id"
    done
  fi
  if [[ "$root" == "$mainwt"/* ]] && ! git cat-file -e "$base:${root#"$mainwt"/}/$id.md" 2>/dev/null; then
    git branch -D -q "task/$id"
    die "$id isn't committed on $base, so its worktree wouldn't contain it. Commit the tasks folder on $base, then claim again."
  fi
  dir="${TASK_WORKTREES:-$mainwt.worktrees}/$id"
  git worktree add -q "$dir" "task/$id" >&2 ||
    { git branch -D -q "task/$id"; die "git worktree add failed, so $id was released. Try claiming again."; }
  echo "$dir"
}

# The ID of the current task/<id> branch, for <command> called without one.
branch_task() {
  local b
  b=$(git branch --show-current 2>/dev/null || true)
  [[ "$b" == task/* ]] || usage_error "not on a task/<id> branch, so pass the id: task $1 <id>"
  echo "${b#task/}"
}

# The file of task <id> in this worktree: the copy that lands with the task's merge.
task_file() {
  local f
  if [[ -n "$mainwt" && "$root" == "$mainwt"/* ]]; then
    f="$(git rev-parse --show-toplevel)/${root#"$mainwt"/}/$1.md"
  else
    f="$root/$1.md"
  fi
  [[ -f "$f" && "$1" != README && "$1" != */README ]] ||
    die "no task file for $1 at $f. See the IDs in: task list"
  echo "$f"
}

# Set status: done in task file <file>.
set_done() {
  [[ "$(head -1 "$1")" == "---" ]] || die "$1 has no frontmatter; add a status: line between --- lines"
  awk 'NR == 1 { fm = 1; print; next }
       fm && /^status:/ { if (!s) print "status: done"; s = 1; next }
       fm && $0 == "---" { if (!s) print "status: done"; fm = 0 }
       { print }' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

cmd_done() {
  local id=${1:-} f
  (($# <= 1)) || usage_error "done takes at most one task id"
  [[ -n "$id" ]] || id=$(branch_task "done")
  # Elsewhere, done would count before the merge and leave the branch's copy todo.
  if git show-ref -q --verify "refs/heads/task/$id" &&
     [[ "$(git branch --show-current 2>/dev/null)" != "task/$id" ]]; then
    die "$id is claimed, so mark it done on its branch task/$id, in its worktree. Once that branch is merged, task finish $id cleans up."
  fi
  f=$(task_file "$id")
  set_done "$f"
  echo "$id"
}

cmd_finish() {
  local force=0 all=0 ids=() rows id line state branch wt ws here marked
  while (($#)); do
    case "$1" in
      --force) force=1 ;;
      --all)   all=1 ;;
      -*)      usage_error "unknown option for finish: $1" ;;
      *)       ids+=("$1") ;;
    esac
    shift
  done
  [[ -n "$mainwt" ]] || die "not in a git repo; tasks are claimed with git branches"
  rows=$(report)
  if ((all)); then
    ((!force && ${#ids[@]} == 0)) || usage_error "finish --all takes no ids, and no --force"
    while IFS= read -r id; do ids+=("$id"); done < <(awk -F'\t' '$5 == "merged" && $7 != "dirty" { print $2 }' <<< "$rows")
    ((${#ids[@]})) || { echo "task: nothing to finish" >&2; return 0; }
  fi
  ((${#ids[@]})) || usage_error "finish needs a task id, or --all"
  here=$(pwd -P)
  for id in "${ids[@]}"; do
    line=$(awk -F'\t' -v id="$id" '$2 == id' <<< "$rows")
    [[ -n "$line" ]] || die "unknown task: $id. See the IDs in: task list"
    state=$(cut -f1 <<< "$line") branch=$(cut -f5 <<< "$line")
    wt=$(cut -f6 <<< "$line") ws=$(cut -f7 <<< "$line")
    [[ -n "$branch" ]] || die "$id is not claimed: there is no branch task/$id to finish"
    if ((!force)); then
      case "$branch" in
        new)   die "task/$id has no commits yet. To release $id anyway: task finish --force $id" ;;
        ahead) die "task/$id has commits that aren't on main; merge them first. To drop them: task finish --force $id" ;;
      esac
      [[ "$ws" != dirty ]] || die "$id's worktree has uncommitted changes: $wt. To drop them: task finish --force $id"
    fi
    if [[ -n "$wt" && "$ws" != missing ]]; then
      [[ "$here/" != "$(cd "$wt" && pwd -P)/"* ]] || die "you are inside $id's worktree; run task finish from elsewhere"
      if ((force)); then git worktree remove --force "$wt"; else git worktree remove "$wt"; fi
    elif [[ "$ws" == missing ]]; then
      git worktree prune
    fi
    git branch -D -q "task/$id"
    marked=""
    if [[ "$state" == claimed && "$branch" == merged ]]; then
      set_done "$root/$id.md"
      marked=", marked done on main (uncommitted)"
    fi
    echo "$id: ${wt:+removed its worktree, }deleted task/$id$marked"
  done
}

cmd_path() {
  local id=${1:-} f base dir="" part
  (($# <= 1)) || usage_error "path takes at most one task id"
  [[ -n "$id" ]] || id=$(branch_task path)
  f=$(task_file "$id")
  echo "$f"
  base=${f%"/$id.md"}
  if [[ -f "$base/README.md" ]]; then echo "$base/README.md"; fi
  while [[ "$id" == */* ]]; do  # each folder above the task, from the top down
    part=${id%%/*}; id=${id#*/}
    dir+="${dir:+/}$part"
    if [[ -f "$base/$dir/README.md" ]]; then echo "$base/$dir/README.md"; fi
  done
}

cmd=${1:-}
(($#)) && shift
case "$cmd" in
  ready|next) (($# == 0)) || usage_error "$cmd takes no arguments" ;;
esac
case "$cmd" in
  list)  cmd_list "$@" ;;
  ready) scan | awk -F'\t' '$1 == "ready" { print $2 }' ;;
  next)  cmd_next ;;
  add)   cmd_add "$@" ;;
  claim) cmd_claim "$@" ;;
  done)  cmd_done "$@" ;;
  path)  cmd_path "$@" ;;
  finish) cmd_finish "$@" ;;
  help|-h|--help) usage ;;
  "")    usage_error "missing command" ;;
  *)     usage_error "unknown command: $cmd" ;;
esac
