{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"types": ["bun"],
		"allowArbitraryExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["*.ts", "*.tsx"]
}
