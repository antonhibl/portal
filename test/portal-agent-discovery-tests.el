(require 'portal-agents-tests
         (expand-file-name "portal-agents-tests" (file-name-directory (or load-file-name (bound-and-true-p byte-compile-current-file) buffer-file-name))))

(defvar portal-discovery-test--processes nil)
(defvar portal-discovery-test--queries 0)
(defconst portal-discovery-test--fixtures
  (expand-file-name "fixtures/agent-signals/" (file-name-directory (or load-file-name (bound-and-true-p byte-compile-current-file) buffer-file-name))))

(defmacro portal-discovery-test--environment (&rest body)
  "Run BODY with real query pipes and controllable native process snapshots."
  (declare (indent 0))
  `(portal-agents-test--environment
     (let ((portal-agent-discovery--agents nil)
           (portal-agent-discovery--hidden nil)
           (portal-agent-discovery--queried 0)
           (portal-agent-discovery--pending nil)
           (portal-discovery-test--processes nil)
           (portal-discovery-test--queries 0)
           (make (symbol-function 'make-process)))
       (cl-letf (((symbol-function 'portal--process-snapshot)
                  (lambda (variable)
                    (should (equal variable "PORTAL_TERMINAL"))
                    portal-discovery-test--processes))
                 ((symbol-function 'make-process)
                  (lambda (&rest args)
                    (should (equal (plist-get args :command) '("claude" "agents" "--json")))
                    (cl-incf portal-discovery-test--queries)
                    ;; A real pipe/filter/sentinel, with explicitly delivered JSON.
                    (apply make (plist-put args :command '("/bin/cat"))))))
         (unwind-protect (progn ,@body)
           (portal-agent-discovery--stop))))))

(defun portal-discovery-test--process (buffer pid &optional start)
  "Process snapshot entry for BUFFER, PID and START."
  (list :pid pid :start (or start "100.000001")
        :environment (format "%d/%s" (emacs-pid) (buffer-local-value 'portal-view--target buffer))
        :executable "/home/test/.local/share/claude/versions/2.1.287"
        :argv '("claude") :ancestors '(1)))

(defun portal-discovery-test--reply (text)
  "Complete the current query with TEXT and run its sentinel."
  (let ((process portal-agent-discovery--process)
        (end (+ (float-time) 2)))
    (should (process-live-p process))
    (process-send-string process text)
    (process-send-eof process)
    (while (and (eq process portal-agent-discovery--process) (< (float-time) end))
      (accept-process-output nil 0.01))
    (should-not (eq process portal-agent-discovery--process))))

(defun portal-discovery-test--status (buffer)
  "Activity in BUFFER's actual dashboard row."
  (nth 4 (portal-agents-test--row buffer)))

(ert-deftest portal-discovery-identities-controls-and-manual-policy ()
  (portal-discovery-test--environment
    (let* ((one (portal-agents-test--open "one/app"))
           (two (portal-agents-test--open "one/app"))
           (control (portal-agents-test--open "two/app"))
           (first (portal-discovery-test--process one 10))
           (second (portal-discovery-test--process two 20))
           (fake (plist-put (portal-discovery-test--process control 30) :executable "/bin/sleep")))
      (portal-agents-test--report control :title "✳ Claude Code" :progress "indeterminate")
      (setq portal-discovery-test--processes (list first second fake))
      (portal-agents-test--show)
      (should (= (length (portal-agents-test--rows)) 2))
      (should (equal (portal-discovery-test--status one) "unknown"))
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"},{\"pid\":20,\"status\":\"waiting\"}]")
      (should (equal (portal-discovery-test--status one) "working"))
      (should (equal (portal-discovery-test--status two) "waiting"))
      (with-current-buffer one (rename-buffer "renamed Claude"))
      (portal-agents-test--report one :pwd (portal-agents-test--path "two/app"))
      (portal-agents--tick)
      (should (equal (car (portal-agents-test--row one)) "renamed Claude"))
      (with-current-buffer one
        (cl-letf (((symbol-function 'read-buffer)
                   (lambda (_prompt default _match predicate)
                     (should (eq default one))
                     (should (funcall predicate (cons (buffer-name one) one)))
                     (buffer-name one))))
          (call-interactively #'portal-agents-untrack)))
      (portal-agents--tick)
      (should-not (portal-agents-test--row one))
      (portal-agents-track one "My reviewer")
      (should (equal (nth 1 (portal-agents-test--row one)) "My reviewer"))
      (should (= (length (portal-agents-test--rows)) 2))
      (portal-agents-untrack one)
      (setq portal-discovery-test--processes (list second))
      (portal-agents--tick)
      (setq portal-discovery-test--processes (list (portal-discovery-test--process one 11) second))
      (portal-agents--tick)
      (should (equal (portal-discovery-test--status one) "unknown"))
      (should (equal (nth 1 (portal-agents-test--row one)) "Claude")))))

(ert-deftest portal-discovery-retracking-requires-fresh-status ()
  (dolist (live '(nil t))
    ;; A request from before untracking may finish while hidden or retracked.
    (dolist (completion '(nil hidden retracked))
      (portal-discovery-test--environment
        (let ((portal-agents-live-update live)
              (terminal (portal-agents-test--open "one/app")))
          (setq portal-discovery-test--processes (list (portal-discovery-test--process terminal 10)))
          (portal-agents-test--show)
          (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
          (should (equal (portal-discovery-test--status terminal) "working"))
          (when completion (portal-agent-discovery--collect t))
          (portal-agents-untrack terminal)
          (should-not (portal-agents-test--row terminal))
          (when (eq completion 'hidden)
            (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]"))
          ;; No title or progress change: the gap alone invalidates activity.
          (portal-agents-track terminal "My reviewer")
          (should (equal (portal-discovery-test--status terminal) "unknown"))
          (when (eq completion 'retracked)
            (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
            (should (equal (portal-discovery-test--status terminal) "unknown")))
          (portal-agents--tick)
          (unless live
            (should-not portal-agent-discovery--process)
            (with-current-buffer portal-agents--buffer (revert-buffer)))
          (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
          (should (equal (portal-discovery-test--status terminal) "idle"))
          (should (equal (nth 1 (portal-agents-test--row terminal)) "My reviewer"))
          ;; Merely changing a visible run's label preserves verified activity.
          (let ((queries portal-discovery-test--queries))
            (portal-agents-track terminal "Renamed reviewer")
            (portal-agents--tick)
            (should (equal (portal-discovery-test--status terminal) "idle"))
            (should (= portal-discovery-test--queries queries))))))))

(ert-deftest portal-discovery-spoofed-runtime-does-not-create-a-row ()
  (portal-discovery-test--environment
    (let* ((terminal (portal-agents-test--open "one/app"))
           (process (portal-discovery-test--process terminal 10)))
      ;; exec -a can give a runtime Claude's name without running Claude.
      (setq portal-discovery-test--processes
            (list (plist-put (plist-put process :executable "/opt/bin/node")
                             :argv '("claude" "-e" "setInterval(() => {}, 1000)"))))
      (portal-agents-test--report terminal :title "✳ Claude Code" :progress "indeterminate")
      (portal-agents-test--show)
      (should-not (portal-agents-test--rows))
      (should (= portal-discovery-test--queries 0)))))

(ert-deftest portal-discovery-classification-and-nesting ()
  (portal-discovery-test--environment
    (let* ((terminal (portal-agents-test--open "one/app"))
           (parent (portal-discovery-test--process terminal 10))
           (child (plist-put (portal-discovery-test--process terminal 20) :ancestors '(15 10 1))))
      (dolist (argv '(("node" "/opt/bin/claude") ("bun" "/opt/bin/claude")
                      ("python3" "/opt/bin/claude") ("bash" "/opt/bin/claude")))
        (should (equal "claude" (portal-agent-discovery--name
                                (list :argv argv :executable (concat "/bin/" (car argv)))))))
      (dolist (process '((:argv ("claude") :executable "/bin/sleep")
                         (:argv ("claude") :executable "/bin/node")
                         (:argv ("claude" "-lc" "sleep 10") :executable "/bin/bash")
                         (:argv ("node" "-e" "claude") :executable "/bin/node")
                         (:argv ("bash" "-c" "claude") :executable "/bin/bash")
                         (:argv ("bash" "-lc" "claude") :executable "/bin/bash")
                         (:argv ("node" "--eval=1" "claude") :executable "/bin/node")
                         (:argv ("claude") :executable "/opt/not-claude/versions/1")))
        (should-not (portal-agent-discovery--name process)))
      (setq portal-discovery-test--processes (list child parent))
      (portal-agents-test--show)
      (should (= (length portal-agent-discovery--agents) 1))
      (should (= (portal-agent-pid (car portal-agent-discovery--agents)) 10))
      (portal-discovery-test--reply "[]")
      (setq portal-discovery-test--processes
            (list child (plist-put (plist-put parent :argv '("codex")) :executable "/bin/codex")))
      (portal-agents--tick)
      (should-not (portal-agents-test--rows))
      ;; Pi legitimately renames Node via process.title, losing its script argv.
      (setq portal-discovery-test--processes
            (list child (plist-put (plist-put parent :argv '("pi")) :executable "/bin/node")))
      (portal-agents--tick)
      (should-not (portal-agents-test--rows))
      (setq portal-discovery-test--processes
            (list (plist-put (copy-sequence child) :environment "999999/terminal:1")))
      (portal-agents--tick)
      (should-not (portal-agents-test--rows)))))

(ert-deftest portal-discovery-pending-transitions-pid-reuse-and-late-results ()
  (portal-discovery-test--environment
    (let* ((terminal (portal-agents-test--open "one/app"))
           (original (portal-discovery-test--process terminal 10)))
      (setq portal-discovery-test--processes (list original))
      (portal-agents-test--show)
      (portal-agents-test--report terminal :title "◐ Work" :progress "indeterminate")
      (portal-agents-test--report terminal :title nil :progress nil)
      (should portal-agent-discovery--pending)
      (should (= portal-discovery-test--queries 1))
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
      (should (= portal-discovery-test--queries 2))
      (should (equal (portal-discovery-test--status terminal) "unknown"))
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"waiting\"}]")
      (should (equal (portal-discovery-test--status terminal) "waiting"))
      (portal-agent-discovery--collect t)
      ;; Same PID, different start time: the old response cannot apply.
      (setq portal-discovery-test--processes (list (portal-discovery-test--process terminal 10 "200.000002")))
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
      (should (equal (portal-discovery-test--status terminal) "unknown"))
      (setq portal-discovery-test--processes nil)
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
      (should-not (portal-agents-test--rows))
      (setq portal-discovery-test--processes (list original))
      (portal-agents--tick)
      ;; Closing a terminal before the result arrives cannot recreate its row.
      (kill-buffer terminal)
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
      (should-not (portal-agents-test--rows)))))

(ert-deftest portal-discovery-query-failure-timeout-recovery-and-hidden-cleanup ()
  (portal-discovery-test--environment
    (let ((terminal (portal-agents-test--open "one/app")))
      (setq portal-discovery-test--processes (list (portal-discovery-test--process terminal 10)))
      (portal-agents-test--show)
      (portal-discovery-test--reply "not json")
      (should (string-match-p "Invalid" (portal-agent-reason (car portal-agent-discovery--agents))))
      (portal-agent-discovery--collect t)
      (let ((end (+ (float-time) 2)))
        (funcall (timer--function portal-agent-discovery--timeout))
        (while (and portal-agent-discovery--process (< (float-time) end))
          (accept-process-output nil 0.01)))
      (should-not portal-agent-discovery--process)
      (should (string-match-p "timed out" (portal-agent-reason (car portal-agent-discovery--agents))))
      (portal-agent-discovery--collect t)
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
      (should (equal (portal-discovery-test--status terminal) "idle"))
      (cl-letf (((symbol-function 'portal--process-snapshot) (lambda (_) (error "source lost"))))
        (portal-agents--tick))
      (should (equal (portal-discovery-test--status terminal) "unknown"))
      (should (equal (nth 3 (portal-agents-test--row terminal)) "unknown"))
      (portal-agent-discovery--collect t)
      (let ((query portal-agent-discovery--process))
        (switch-to-buffer terminal)
        (portal-agents--window-changed)
        (should-not (process-live-p query))
        (should-not (buffer-live-p (process-buffer query)))
        (should-not portal-agent-discovery--timeout))
      (cl-letf (((symbol-function 'portal--process-snapshot) (lambda (_) (ert-fail "Hidden scan"))))
        (portal-agents--tick)
        (portal-agents-test--report terminal :title "◐ Hidden" :progress "indeterminate"))
      (portal-agents-test--show)
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
      (should (equal (portal-discovery-test--status terminal) "working")))))

(ert-deftest portal-discovery-pausing-refreshes-visible-activity ()
  (portal-discovery-test--environment
    (let ((terminal (portal-agents-test--open "one/app")))
      (setq portal-discovery-test--processes (list (portal-discovery-test--process terminal 10)))
      (portal-agents-test--show)
      ;; Both the interactive toggle and a setting noticed on the next tick
      ;; invalidate displayed activity without starting another collection.
      (dolist (pause '(toggle setting))
        (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
        (should (equal (portal-discovery-test--status terminal) "working"))
        (let ((queries portal-discovery-test--queries))
          (cl-letf (((symbol-function 'portal--process-snapshot)
                     (lambda (_) (ert-fail "Pausing scanned processes"))))
            (if (eq pause 'toggle)
                (portal-agents-toggle-live-update -1)
              (setq portal-agents-live-update nil)
              (portal-agents--tick)))
          (should (= queries portal-discovery-test--queries)))
        (should-not portal-agents--timer)
        (should-not portal-agent-discovery--process)
        (let ((activity (portal-discovery-test--status terminal)))
          (should (equal activity "unknown"))
          (should (equal (get-text-property 0 'help-echo activity) "Refresh paused")))
        ;; Refreshing manually still completes its one requested query.
        (with-current-buffer portal-agents--buffer (revert-buffer))
        (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
        (should (equal (portal-discovery-test--status terminal) "idle"))
        (when (eq pause 'toggle) (portal-agents-toggle-live-update 1))))))

(ert-deftest portal-discovery-manual-mode-and-unchanged-spinner ()
  (portal-discovery-test--environment
    (let ((terminal (portal-agents-test--open "one/app"))
          (portal-agents-live-update nil))
      (setq portal-discovery-test--processes (list (portal-discovery-test--process terminal 10)))
      (portal-agents-test--show)
      (should-not portal-agents--timer)
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
      (should (equal (portal-discovery-test--status terminal) "idle"))
      (portal-agents-test--report terminal :title "◐ Work" :progress "indeterminate")
      (should-not portal-agent-discovery--process)
      (with-current-buffer portal-agents--buffer (revert-buffer))
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
      (portal-agents-toggle-live-update 1)
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"busy\"}]")
      (let ((queries portal-discovery-test--queries))
        (cl-letf (((symbol-function 'portal-agents--print) (lambda (_) (ert-fail "Spinner redrew table"))))
          (dolist (title '("◑ Work" "◒ Work" "⠋ Work"))
            (portal-agents-test--report terminal :title title)
            (portal-agents--tick)))
        (should (= queries portal-discovery-test--queries)))
      (let ((portal-agents-discover-claude nil))
        (portal-agents--tick)
        (should-not (portal-agents-test--rows)))
      (portal-agents--tick)
      (should (portal-agents-test--row terminal)))))

(ert-deftest portal-discovery-replays-real-claude-fixtures-through-rows ()
  (dolist (fixture '("claude-lifecycle.jsonl" "claude-queued-compact.jsonl"
                     "claude-model-error.jsonl" "claude-trust-dialog.jsonl"))
    (portal-discovery-test--environment
      (let* ((terminal (portal-agents-test--open "one/app"))
             (process (portal-discovery-test--process terminal 10))
             (events (with-temp-buffer
                       (insert-file-contents (expand-file-name fixture portal-discovery-test--fixtures))
                       (mapcar (lambda (line) (json-parse-string line :object-type 'plist))
                               (split-string (buffer-string) "\n" t)))))
        (portal-agents-test--show)
        (dolist (event events)
          (pcase (plist-get event :kind)
            ("spawn" (setq portal-discovery-test--processes (list process)) (portal-agents--tick))
            ("title" (portal-agents-test--report terminal :title (plist-get event :title)))
            ("progress" (portal-agents-test--report terminal :progress (format "%s" (plist-get event :state))))
            ("claude_agents_status"
             (when (portal-agent-discovery--find terminal)
               (unless portal-agent-discovery--process (portal-agent-discovery--collect t))
               (let* ((status (plist-get event :status))
                      (json (if (equal status "absent") "[]"
                              (json-encode (vector (list :pid 10 :status status))))))
                 (portal-discovery-test--reply json)
                 (when portal-agent-discovery--process (portal-discovery-test--reply json))
                 (should (equal (portal-discovery-test--status terminal)
                                (or (cdr (assoc status '(("busy" . "working") ("idle" . "idle")
                                                        ("waiting" . "waiting")))) "unknown"))))))
            ("exit" (setq portal-discovery-test--processes nil) (portal-agents--tick)
             (should-not (portal-agents-test--row terminal)))))))))

(ert-deftest portal-discovery-status-schema-polls-and-output-bounds ()
  (should (equal (gethash 10 (portal-agent-discovery--statuses
                            "[{\"kind\":\"background\",\"state\":\"blocked\"},{\"pid\":10,\"status\":\"busy\"}]")) "busy"))
  (dolist (bad '("{}" "[7]" "[{\"pid\":10}]"
                "[{\"pid\":10,\"status\":\"idle\"},{\"pid\":10,\"status\":\"busy\"}]"))
    (should-error (portal-agent-discovery--statuses bad)))
  (portal-discovery-test--environment
    (let ((terminal (portal-agents-test--open "one/app")))
      (setq portal-discovery-test--processes (list (portal-discovery-test--process terminal 10)))
      (portal-agents-test--show)
      (portal-discovery-test--reply "[]")
      (portal-agents--tick)
      (should-not portal-agent-discovery--process)
      (setq portal-agent-discovery--queried (- (float-time) 5))
      (portal-agents--tick)
      (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]")
      (setq portal-agent-discovery--queried (- (float-time) 31))
      (portal-agents--tick)
      (should portal-agent-discovery--process)
      (let ((process portal-agent-discovery--process))
        (funcall (process-filter process) process (make-string (1+ (* 1024 1024)) ?x))
        (accept-process-output nil 0.01))
      (should (string-match-p "too large" (portal-agent-reason (car portal-agent-discovery--agents)))))))

(ert-deftest portal-discovery-replaced-view-and-failed-scan-cannot-retain-row ()
  (portal-discovery-test--environment
    (let ((terminal (portal-agents-test--open "one/app")))
      (setq portal-discovery-test--processes (list (portal-discovery-test--process terminal 10)))
      (portal-agents-test--show)
      (with-current-buffer terminal
        (portal-terminal-close)
        (portal-terminal-mode)
        (portal-view-open 'terminal (list :directory default-directory)))
      (cl-letf (((symbol-function 'portal--process-snapshot) (lambda (_) (error "unavailable"))))
        (portal-discovery-test--reply "[{\"pid\":10,\"status\":\"idle\"}]"))
      (should-not (portal-agents-test--rows)))))

