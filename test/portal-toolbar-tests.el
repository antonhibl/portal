;;; portal-toolbar-tests.el --- Native toolbar command contracts -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'portal-input)

(ert-deftest portal-toolbar-commands-read-native-state ()
  (let ((native-value 100) calls)
    (cl-letf (((symbol-function 'portal-view-target) (lambda (&rest _) "web:3"))
              ((symbol-function 'portal--toolbar-action)
               (lambda (target action)
                 (push (list target action) calls)
                 (when (equal action "increase") (setq native-value 110))
                 (format "{\"value\":%d,\"toc\":true}" native-value))))
      (should (= (portal-zoom-in) 110))
      ;; A native button click must not leave a stale Lisp copy.
      (setq native-value 175)
      (should (= (portal-zoom-out) 175))
      (should (portal-toggle-toc))
      (should (equal (car calls) '("web:3" "toc")))
      (should-error (portal-terminal-text-size-increase) :type 'user-error))))

(ert-deftest portal-toolbar-setting-applies-live ()
  (let (values)
    (cl-letf (((symbol-function 'portal--toolbar) (lambda (value) (push value values))))
      (let ((portal-toolbar nil))
        (setq portal-toolbar t)
        (setq portal-toolbar nil))
      (should (equal (reverse values) '(nil t nil t))))))

(ert-deftest portal-toolbar-find-keeps-field-focus-after-prefix ()
  (let ((portal-input--resume t))
    (cl-letf (((symbol-function 'portal-view-target) (lambda (&rest _) "web:7"))
              ((symbol-function 'portal--toolbar-action) (lambda (&rest _) "{\"find\":true}")))
      (portal-find)
      (should-not portal-input--resume))))

(ert-deftest portal-toolbar-input-mode-leaves-header-alone ()
  (with-temp-buffer
    (setq-local header-line-format "User header")
    (portal-input-mode 1)
    (should (equal header-line-format "User header"))
    (portal-input-mode -1)
    (should (equal header-line-format "User header"))))

(ert-deftest portal-toolbar-default-label-names-the-view ()
  (with-temp-buffer
    (rename-buffer "*terminal: portal*" t)
    (should (equal (portal-toolbar-default-label) (buffer-name)))
    (setq-local portal-web--url "https://example.org/docs/")
    (should (equal (portal-toolbar-default-label) "example.org/docs"))
    (setq-local portal-web--hosted-path "/excalidraw/?file=x")
    (should (equal (portal-toolbar-default-label) "/excalidraw/"))
    (setq-local portal-web--preview (concat "file://" (expand-file-name "~/a b/page.html")))
    (should (equal (portal-toolbar-default-label) "~/a b/page.html"))
    (setq-local portal-web--markdown (expand-file-name "~/notes/plan.md"))
    (should (equal (portal-toolbar-default-label) "~/notes/plan.md"))))

(ert-deftest portal-toolbar-labels-reach-the-view-only-when-they-change ()
  (with-temp-buffer
    (let ((buffer (current-buffer)) sent)
      (setq-local portal-view--target "terminal:4")
      (cl-letf (((symbol-function 'portal--toolbar-label)
                 (lambda (target label) (push (cons target label) sent)))
                ((symbol-function 'portal-view-buffers) (lambda (&rest _) (list buffer))))
        (portal-toolbar--sync-labels)
        (portal-toolbar--sync-labels)
        (should (equal sent (list (cons "terminal:4" (buffer-name)))))
        (rename-buffer "*terminal: renamed*" t)
        (portal-toolbar--sync-labels)
        (should (equal (cdar sent) (buffer-name)))
        ;; A failing label function is demoted, and sends an empty label.
        (let ((portal-toolbar-label-function (lambda () (error "No label"))))
          (portal-toolbar--sync-labels))
        (should (equal (cdar sent) ""))))))
