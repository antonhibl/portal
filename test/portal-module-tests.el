;;; portal-module-tests.el --- The C module bindings with a fake backend -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

;; Loads the real Emacs bindings, native/Core/emacs.c, linked with
;; test/portal-fake-backend.c instead of the macOS backend.  The module file
;; is named by PORTAL_TEST_MODULE; run with --module-assertions.  The fake
;; reports what it received through `portal--inspect', and the target "fake"
;; reports its global settings.

(require 'ert)

(let ((file (getenv "PORTAL_TEST_MODULE")))
  (unless (and file (file-exists-p file))
    (error "Set PORTAL_TEST_MODULE to the fake-backend module"))
  (module-load file))

(defconst portal-module-tests--exports
  '((portal--open 2 . 2) (portal--place 3 . 3) (portal--hide 1 . 1) (portal--close 1 . 1)
    (portal--inspect 1 . 1) (portal--channel 1 . 1)
    (portal--web-load 2 . 2) (portal--web-send 2 . 2) (portal--web-receive 1 . 1)
    (portal--terminal-paste 2 . 3) (portal--terminal-text 1 . 1)
    (portal--terminal-theme 1 . 1) (portal--terminal-themes 0 . 0)
    (portal--terminal-bindings 1 . 1)
    (portal--input 2 . 3) (portal--input-prefix 2 . 2)
    (portal--toolbar 1 . 1) (portal--toolbar-theme 1 . 1) (portal--toolbar-action 2 . 2))
  "The 19 exports of docs/adr/0002 and their arities.")

(defun portal-module-tests--next-id ()
  "Open and close a view; return the ID the backend gives the next one."
  (let* ((target (portal--open "terminal" nil))
         (id (plist-get (portal--inspect target) :id)))
    (portal--close target)
    (1+ id)))

(defmacro portal-module-tests--untouched (&rest body)
  "Run BODY and check that it opened no view in the backend."
  (declare (indent 0))
  `(let ((before (portal-module-tests--next-id)))
     ,@body
     (should (= (portal-module-tests--next-id) (1+ before)))))

(ert-deftest portal-module-registers-the-interface ()
  (should (featurep 'portal-native-module))
  (pcase-dolist (`(,name . ,arity) portal-module-tests--exports)
    (should (equal (cons name (func-arity name)) (cons name arity)))
    (should (stringp (documentation name)))))

(ert-deftest portal-module-lifecycle ()
  (let ((target (portal--open "web" '(:directory "~/Ωmega" :quick t :toolbar nil))))
    (should (string-match-p "\\`web:[0-9]+\\'" target))
    (let ((state (portal--inspect target)))
      (should (equal (plist-get state :kind) "web"))
      (should (integerp (plist-get state :id)))
      (should (equal (plist-get state :directory) "~/Ωmega"))
      (should (eq (plist-get state :quick) t))
      (should (plist-member state :toolbar))
      (should-not (plist-get state :toolbar))
      (should-not (plist-get state :visible)))
    (should (eq (portal--place target [10 20 110 220] "frame ✓") t))
    (let ((state (portal--inspect target)))
      (should (equal (plist-get state :edges) '(10 20 110 220)))
      (should (equal (plist-get state :title) "frame ✓"))
      (should (eq (plist-get state :visible) t)))
    (should (eq (portal--hide target) t))
    (should-not (plist-get (portal--inspect target) :visible))
    (should (eq (portal--close target) t))
    (should-not (portal--inspect target))
    (should (equal (should-error (portal--close target))
                   `(error ,(format "No Portal view %s" target))))))

(ert-deftest portal-module-copies-strings-exactly ()
  (let* ((text (string ?a 0 ?b ?é ?🙂))
         (target (portal--open "terminal" (list :name text :name "last"))))
    ;; Explicit lengths keep NUL bytes; a later duplicate option wins.
    (should (equal (plist-get (portal--inspect target) :name) "last"))
    (should (eq (portal--terminal-paste target text) t))
    (should (equal (portal--terminal-text target) text))
    (should (equal (portal--terminal-text target) (portal--terminal-text target)))
    (portal--close target)
    (setq target (portal--open "web" (list :empty "" :json (string ?\" ?\\ 0 ?é ?\n))))
    ;; Structured results cross as JSON.
    (should (equal (plist-get (portal--inspect target) :empty) ""))
    (should (equal (plist-get (portal--inspect target) :json) (string ?\" ?\\ 0 ?é ?\n)))
    (portal--close target)))

(ert-deftest portal-module-rejects-malformed-strings ()
  (let ((target (portal--open "web" nil)))
    (portal-module-tests--untouched
      (dolist (bad (list 1 'web nil [?w ?e ?b]
                         (string-to-unibyte "\377") ; Raw bytes.
                         (string #xd800)            ; A surrogate.
                         (string #x3fff80)))        ; A raw-byte character.
        (should (eq (car (should-error (portal--open bad nil))) 'wrong-type-argument))
        (should (eq (car (should-error (portal--web-load target bad))) 'wrong-type-argument))
        (when (stringp bad)
          (should (eq (car (should-error (portal--open "web" (list :a bad))))
                      'wrong-type-argument)))))
    (should-not (plist-get (portal--inspect target) :url))
    ;; ASCII unibyte strings are fine.
    (should (eq (portal--web-load target (string-to-unibyte "about:blank")) t))
    (should (equal (plist-get (portal--inspect target) :url) "about:blank"))
    (portal--close target)))

(ert-deftest portal-module-rejects-malformed-edges ()
  (let ((target (portal--open "web" nil)))
    (dolist (case `(((10 20 30 40) . wrong-type-argument)
                    ("abcd" . wrong-type-argument)
                    ([10 20 30] . error)
                    ([10 20 30 40 50] . error)
                    ([10 20 30 x] . wrong-type-argument)
                    ([10 20 30 1.5] . wrong-type-argument)
                    ([10 20 30 ,(expt 2 80)] . overflow-error)
                    ([10 20 5 40] . error)))  ; The backend checks dimensions.
      (should (eq (car (should-error (portal--place target (car case) "title"))) (cdr case))))
    (should-error (portal--place target [0 0 1 1] 'title) :type 'wrong-type-argument)
    (let ((state (portal--inspect target)))
      (should-not (plist-get state :edges))
      (should-not (plist-get state :title))
      (should-not (plist-get state :visible)))
    (portal--close target)))

(ert-deftest portal-module-rejects-malformed-options ()
  (let ((circular (list :a "b")))
    (setcdr (cdr circular) circular)
    (portal-module-tests--untouched
      (dolist (case `((:a . "Options must be a plist")
                      ((:a) . "Options must be a plist")
                      ((:a "b" . "c") . "Options must be a plist")
                      (,circular . "Options must be a plist")
                      ([:a "b"] . "Options must be a plist")
                      ("ab" . "Options must be a plist")
                      ((a "b") . "Option names must be keywords")
                      (("a" "b") . "Option names must be keywords")
                      ((:a "b" 1 "c") . "Option names must be keywords")
                      ((:a 1) . "Option :a must be a string, t or nil")
                      ((:a web) . "Option :a must be a string, t or nil")
                      ((:a ("b")) . "Option :a must be a string, t or nil")))
        (should (equal (should-error (portal--open "web" (car case)))
                       (list 'error (cdr case))))))))

(ert-deftest portal-module-optional-arguments ()
  (let ((terminal (portal--open "terminal" nil)))
    (should (eq (portal--terminal-paste terminal "a") t))
    (should (eq (portal--terminal-paste terminal "b" nil) t))
    (should (eq (portal--terminal-paste terminal "c" 'enter) t))
    (should (equal (portal--terminal-text terminal) "abc\n"))
    (should (eq (portal--input terminal "focus") t))
    (should (eql (plist-get (portal--inspect terminal) :serial) 0))
    (should (eq (portal--input terminal "focus" nil) t))
    (should (eql (plist-get (portal--inspect terminal) :serial) 0))
    (should (eq (portal--input terminal "ack" 7) t))
    (let ((state (portal--inspect terminal)))
      (should (equal (plist-get state :action) "ack"))
      (should (eql (plist-get state :serial) 7)))
    (should-error (portal--input terminal "command" "7") :type 'wrong-type-argument)
    (should (equal (plist-get (portal--inspect terminal) :action) "ack"))
    (should (eq (portal--terminal-theme "Ωmega") t))
    (should (equal (plist-get (portal--inspect "fake") :theme) "Ωmega"))
    (should (eq (portal--terminal-theme nil) t))
    (let ((settings (portal--inspect "fake")))
      (should (plist-member settings :theme))
      (should-not (plist-get settings :theme)))
    (should-error (portal--terminal-theme 'Alpha) :type 'wrong-type-argument)
    (portal--close terminal)))

(ert-deftest portal-module-returns-backend-results ()
  (should (equal (portal--terminal-themes) '("Alpha" "Beta" "Ωmega")))
  (should (eq (portal--input "terminal:0" "focus") nil))
  (let ((terminal (portal--open "terminal" nil)))
    (should (eq (portal--input terminal "pending") nil))
    (portal--close terminal))
  (should (eq (portal--input-prefix "c" 262144) t))
  (let ((settings (portal--inspect "fake")))
    (should (equal (plist-get settings :prefix) "c"))
    (should (eql (plist-get settings :flags) 262144)))
  (should-error (portal--input-prefix "c" "1") :type 'wrong-type-argument)
  (should (eq (portal--terminal-bindings "{\"regular\":[]}") t))
  (should (equal (plist-get (portal--inspect "fake") :bindings) "{\"regular\":[]}"))
  (should (eq (portal--toolbar nil) nil))
  (should (eq (plist-get (portal--inspect "fake") :toolbar) nil))
  (should (eq (portal--toolbar 'yes) t))
  (should (eq (plist-get (portal--inspect "fake") :toolbar) t))
  (should (eq (portal--toolbar-theme "{\"background\":[0,0,0]}") t))
  (let ((web (portal--open "web" '(:hosted t))))
    (should (equal (portal--toolbar-action web "zoom-in") "{\"action\":\"zoom-in\"}"))
    (should (equal (portal--web-receive web) "[]"))
    (should (eq (portal--web-send web "{\"a\":1}") t))
    (should (eq (portal--web-send web "{\"b\":\"✓\"}") t))
    (should (equal (portal--web-receive web) "[{\"a\":1},{\"b\":\"✓\"}]"))
    (should (equal (portal--web-receive web) "[]"))
    (portal--close web)))

(ert-deftest portal-module-signals-backend-errors ()
  (let ((web (portal--open "web" nil))
        (terminal (portal--open "terminal" nil)))
    (dolist (case `(((portal--open "50%s" nil) . "Unknown Portal view kind: 50%s")
                    ((portal--place "web:0" [0 0 1 1] "t") . "No Portal view web:0")
                    ((portal--hide "web:0") . "No Portal view web:0")
                    ((portal--web-load ,terminal "about:blank") . ,(format "No Portal view %s" terminal))
                    ((portal--web-send ,web "{}")
                     . ,(format "Web view %s is not a hosted app, so it has no bridge" web))
                    ((portal--web-receive ,web)
                     . ,(format "Web view %s is not a hosted app, so it has no bridge" web))
                    ((portal--terminal-paste ,web "x") . ,(format "No Portal view %s" web))
                    ((portal--terminal-text ,web) . ,(format "No Portal view %s" web))
                    ((portal--terminal-theme "Gamma") . "Unknown terminal theme: Gamma")
                    ((portal--terminal-bindings "[]") . "Invalid native terminal binding")
                    ((portal--input-prefix "cc" 1) . "Expected one modified ASCII prefix")
                    ((portal--input ,web "unknown") . "Unknown Portal input action: unknown")
                    ((portal--toolbar-theme "") . "Toolbar theme must be a JSON object")
                    ((portal--toolbar-action ,terminal "zoom-in")
                     . "No toolbar controls for this native view")))
      (should (equal (should-error (apply (caar case) (cdar case))) (list 'error (cdr case)))))
    (portal--close web)
    (portal--close terminal)))

(ert-deftest portal-module-keeps-the-first-pending-signal ()
  ;; Conversion stops at the first bad argument; its signal reaches Lisp intact.
  (let ((target (portal--open "web" nil)))
    (portal-module-tests--untouched
      (should (equal (should-error (portal--open 'web '(:a 1)))
                     '(wrong-type-argument stringp web))))
    (should (equal (should-error (portal--place 1 [a] 'title))
                   '(wrong-type-argument stringp 1)))
    (should (equal (should-error (portal--place target [a b c d] 'title))
                   '(wrong-type-argument integerp a)))
    (should (equal (should-error (portal--input 1 'action "serial"))
                   '(wrong-type-argument stringp 1)))
    ;; Signals leave no state behind: the next calls succeed.
    (should (eq (portal--place target [0 0 1 1] "title") t))
    (should (eq (condition-case nil (portal--hide 'target)
                  (wrong-type-argument (portal--hide target)))
                t))
    (portal--close target)))

(ert-deftest portal-module-connects-the-channel ()
  (let* ((received "")
         (process (make-pipe-process :name "portal-module-test" :noquery t
                                     :filter (lambda (_process text)
                                               (setq received (concat received text))))))
    (unwind-protect
        (progn
          (should (eq (portal--channel process) t))
          (should (eq (plist-get (portal--inspect "fake") :channel) t))
          (with-timeout (5 (ert-fail "No record arrived"))
            (while (not (string-suffix-p "\n" received))
              (accept-process-output process 0.05)))
          (should (equal received "fake connected\n"))
          (should-error (portal--channel "process") :type 'wrong-type-argument)
          (should (eq (portal--channel nil) t))
          (should-not (plist-get (portal--inspect "fake") :channel)))
      (delete-process process))))

